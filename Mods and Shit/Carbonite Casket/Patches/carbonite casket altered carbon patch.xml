<?xml version="1.0" encoding="utf-8"?>
<Patch>
  <Operation Class="PatchOperationFindMod">
    <mods>
      <li>Altered Carbon 2: ReSleeved</li>
    </mods>
    <match Class="PatchOperationSequence">
      <operations>
        <li Class="PatchOperationConditional">
          <xpath>/Defs/ThingDef[defName="CarboniteCasket"]/comps/li[@Class="CompProperties_AffectedByFacilities"]/linkableFacilities</xpath>
          <nomatch Class="PatchOperationAdd">
            <xpath>/Defs/ThingDef[defName="CarboniteCasket"]/comps</xpath>
            <value>
              <li Class="CompProperties_AffectedByFacilities">
                <linkableFacilities>
                  <li>AC_NeuralMatrix</li>
                </linkableFacilities>
              </li>
            </value>
          </nomatch>
          <match Class="PatchOperationAdd">
            <xpath>/Defs/ThingDef[defName="CarboniteCasket"]/comps/li[@Class="CompProperties_AffectedByFacilities"]/linkableFacilities</xpath>
            <value>
              <li>AC_NeuralMatrix</li>
            </value>
          </match>
        </li>
      </operations>
    </match>
  </Operation>
</Patch>
